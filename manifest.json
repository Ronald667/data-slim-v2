<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Data Slim V2 - Save 80% Data</title>

<link rel="manifest" href="/manifest.json
<body style="font-family:sans-serif;text-align:center;padding:15px;background:#f5f5f5">
<h1>🌍 Data Slim V2</h1>
<p>Save data in Limpopo & everywhere!</p>
<input id="url" placeholder="wikipedia.org" style="width:65%;padding:12px;border-radius:8px;border:1px solid #ccc">
<button onclick="go()" style="padding:12px 20px;background:#000;color:#fff;border-radius:8px;border:0">Go</button>
<iframe id="view" style="width:100%;height:65vh;margin-top:15px;border:0;background:white;border-radius:10px"></iframe>
<script>
function go(){
 let u=document.getElementById('url').value;
 if(!u) return;
 if(!u.startsWith('http')) u='https://'+u;
 document.getElementById('view').src='/api/proxy?url='+encodeURIComponent(u);
}
</script>
</body>
</html>
